    {
      "name": "FHIR-Paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deve devolver status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              " ",
              "pm.test(\"A resposta deve ser JSON\", function () {",
              "\tpm.response.to.be.json;",
              "});",
              " ",
              "pm.test(\"A resposta deve estar em formato FHIR Bundle\", function () {",
              "\tconst jsonData = pm.response.json();",
              "\tpm.expect(jsonData).to.have.property(\"resourceType\");",
              "    pm.expect(jsonData.resourceType).to.eql(\"Bundle\");",
              "});",
              " ",
              "pm.test(\"Os recursos devolvidos devem ser pacientes\", function () {",
              "\tconst jsonData = pm.response.json();",
              " ",
              "\tif (jsonData.entry && jsonData.entry.length > 0) {",
              "        jsonData.entry.forEach(function (item) {",
              "            pm.expect(item.resource).to.have.property(\"resourceType\");",
              "            pm.expect(item.resource.resourceType).to.eql(\"Patient\");",
              "    \t});",
              "\t}",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://fhir.hl7.pt/r5/fhir/Patient/",
          "protocol": "http",
          "host": [
            "fhir",
